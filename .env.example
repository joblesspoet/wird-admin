# ============================================================================
# Environment Variables Reference — Wird Admin
# Copy this file to `.env` and `.env.local` locally.
# On Vercel: Settings → Environment Variables → add all of these.
# ============================================================================

# ── Supabase ────────────────────────────────────────────────────────────────
# Find in Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Service role key (server-only, NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx

# Optional: direct Postgres connection (for future Prisma migrations)
# DATABASE_URL="postgresql://postgres.ref:password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require"

# ── Seeder defaults (npm run db:seed) ───────────────────────────────────────
SEED_ADMIN_EMAIL=admin@wird.app
SEED_ADMIN_PASSWORD=Admin@123

# ── App ─────────────────────────────────────────────────────────────────────
# Public URL of the deployed app
NEXT_PUBLIC_APP_URL=https://wird-admin.vercel.app
